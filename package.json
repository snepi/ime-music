{
  "name": "ime-music",
  "productName": "IMe Music",
  "description": "Local music player with recommendations, IMe Waves and phone sync",
  "author": "IMe Music",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "main": "electron/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/snepi/ime-music.git"
  },
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 node scripts/electron-dev.mjs .\"",
    "dev:empty": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 IME_USER_DATA=.screenshot-profile node scripts/electron-dev.mjs . --user-data-dir=.screenshot-profile\"",
    "build": "tsc -b && vite build",
    "dist": "npm run build && electron-builder",
    "icons": "node scripts/apply-app-icon.mjs",
    "postinstall": "node scripts/apply-app-icon.mjs",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "audit": "electron electron/_audit.cjs",
    "lint": "oxlint"
  },
  "build": {
    "appId": "com.ime.music",
    "productName": "IMe Music",
    "copyright": "Copyright © IMe Music",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "build/icon.ico"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "asar": true,
    "npmRebuild": false,
    "icon": "build/icon.ico",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "IMe Music",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "snepi",
        "repo": "ime-music"
      }
    ]
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "jimp": "^1.6.1",
    "music-metadata": "^11.14.0",
    "node-id3": "^0.2.9",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "oxlint": "^1.75.0",
    "png-to-ico": "^3.0.2",
    "rcedit": "^5.0.2",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wait-on": "^8.0.5"
  }
}
